# Contact form (api/contact.js). Set these in Vercel → Settings → Environment
# Variables — never in the page code, and never commit a real key.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender on a domain verified in Resend
CONTACT_FROM="NYT Software Solutions <hello@nytsoftwaresolution.pro.et>"

# Where enquiries are delivered (default: nytsoftwaresolutionplc@gmail.com)
CONTACT_TO=

# Extra origins allowed to post to the form, comma-separated (optional)
CONTACT_ALLOWED_ORIGINS=
