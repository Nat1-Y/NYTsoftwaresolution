---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
const to = (hash: string) => (isHome ? hash : `/${hash}`);
---

<footer class="main-footer">
  <!--
    A tilet band — the woven border of a netela, drawn with two crossed
    gradients. Purely decorative, so it is hidden from assistive tech and
    appears exactly once on the page.
  -->
  <div class="footer-band" aria-hidden="true"></div>

  <div class="container footer-container">
    <div class="footer-left">
      <a href={isHome ? '#top' : '/'} class="logo footer-logo" aria-label={isHome ? 'NYT Software Solutions — back to top' : 'NYT Software Solutions — home'}>
        <Logo size={30} />
        <span class="logo-text" aria-hidden="true">
          <span class="logo-text-main">NYT Software</span>
          <span class="logo-text-sub">Solutions</span>
        </span>
      </a>
      <p class="footer-tagline">
        Building software that powers businesses — with stability, security and
        velocity.
      </p>
    </div>

    <div class="footer-right">
      <nav class="footer-links" aria-label="Explore">
        <h2 class="footer-heading">Explore</h2>
        {nav.slice(0, 4).map((item) => <a href={to(item.href)}>{item.label}</a>)}
        <a href={to('#faq')}>FAQ</a>
      </nav>

      <nav class="footer-links" aria-label="Work with us">
        <h2 class="footer-heading">Work with us</h2>
        <a href="/working-with-us/">How we work</a>
        <a href="/products/cafe-manager/">NYT Cafe Manager</a>
        <a href={to('#engagement')}>Engagement models</a>
        <a href={to('#blueprint')}>Blueprint Studio</a>
        <a href={to('#contact')}>Start a project</a>
      </nav>

      <div class="footer-links">
        <h2 class="footer-heading">Contact</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone && <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>}
        {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="footer-span">{site.locality}, {site.country}</span>
      </div>

      <nav class="footer-links" aria-label="Legal">
        <h2 class="footer-heading">Legal</h2>
        <a href="/privacy/">Privacy notice</a>
        <a href="/terms/">Terms of use</a>
        <span class="footer-span">© {year} {site.legalName}.</span>
      </nav>
    </div>

    <p class="footer-signoff">
      <span>Built in {site.locality}</span>
      <span class="amharic" lang="am">አዲስ አበባ</span>
      <span class="footer-coords">9.03°N 38.74°E · {site.timezone}</span>
    </p>
  </div>
</footer>
