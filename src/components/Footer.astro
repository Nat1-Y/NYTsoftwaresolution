---
import { site, nav } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="main-footer">
  <div class="container footer-container">
    <div class="footer-left">
      <a href="#top" class="logo footer-logo" aria-label="Back to top">
        <Logo size={30} />
        <span class="logo-text" aria-hidden="true">
          <span class="logo-text-main">NYT Software</span>
          <span class="logo-text-sub">Solutions</span>
        </span>
      </a>
      <p class="footer-tagline">
        Building software that powers businesses — with stability, security and
        velocity.
      </p>
    </div>

    <div class="footer-right">
      <nav class="footer-links" aria-label="Footer">
        <h4>Explore</h4>
        {nav.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="#faq">FAQ</a>
      </nav>

      <div class="footer-links">
        <h4>Contact</h4>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="footer-span">{site.locality}, {site.country}</span>
      </div>

      <div class="footer-links">
        <h4>Legal</h4>
        <span class="footer-span">© {year} {site.legalName}.</span>
        <span class="footer-span">All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
