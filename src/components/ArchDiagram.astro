---
/**
 * Architecture diagrams for the case studies.
 *
 * These are schematics of the design described in the technical narrative —
 * not screenshots and not marketing art. They exist because "schema-isolated
 * multi-tenancy" means nothing to a reader until they can see the shape of it.
 */
interface Props {
  variant: 'multitenant' | 'clinical' | 'ticketing' | 'marketplace';
  project: string;
}

const { variant, project } = Astro.props;

const captions: Record<Props['variant'], string> = {
  multitenant:
    'Each tenant resolves to an isolated database schema, so a query can never cross a client boundary. The POS writes to a local IndexedDB queue first and reconciles on reconnect.',
  clinical:
    'Every request resolves the caller’s role before reaching patient data, and reads of clinical records are written to an append-only audit log.',
  ticketing:
    'Redemption is deliberately serialised: the ticket row is locked inside a transaction, so two gates scanning the same code produce exactly one admission.',
  marketplace:
    'Catalogue reads are served from Redis; merchant image uploads are re-encoded to WebP by a background worker rather than on the request path.',
};

const titles: Record<Props['variant'], string> = {
  multitenant: 'Schema-isolated multi-tenancy with offline-first writes',
  clinical: 'Role-gated clinical API with audit logging',
  ticketing: 'Transaction-locked ticket redemption',
  marketplace: 'Cache-fronted catalogue with async media pipeline',
};

const descId = `arch-desc-${variant}`;
---

<figure class="arch-figure">
  <!--
    When the diagram is too wide for its container it scrolls, and a scrollable
    region must be reachable from the keyboard. main.ts adds tabindex only when
    it actually overflows, so we don't leave dead tab stops on wide screens.
  -->
  <div
    class="arch-scroll"
    role="group"
    aria-label={`${project} architecture diagram`}
  >
    <svg
      class="arch-svg"
      viewBox="0 0 520 200"
      role="img"
      aria-labelledby={`${descId}-title`}
      aria-describedby={descId}
    >
      <title id={`${descId}-title`}>{`${project}: ${titles[variant]}`}</title>
      <desc id={descId}>{captions[variant]}</desc>

      <defs>
        <marker
          id={`arrow-${variant}`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" class="arch-arrow" />
        </marker>
        <marker
          id={`arrow-a-${variant}`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" class="arch-arrow-accent" />
        </marker>
      </defs>

      {
        variant === 'multitenant' && (
          <>
            <rect x="10" y="70" width="94" height="52" rx="2" class="arch-node-accent" />
            <text x="57" y="90" text-anchor="middle" class="arch-label">POS Terminal</text>
            <text x="57" y="104" text-anchor="middle" class="arch-sub">IndexedDB queue</text>
            <text x="57" y="115" text-anchor="middle" class="arch-sub">offline-first</text>

            <rect x="150" y="70" width="88" height="52" rx="2" class="arch-node" />
            <text x="194" y="92" text-anchor="middle" class="arch-label">Sync Worker</text>
            <text x="194" y="106" text-anchor="middle" class="arch-sub">idempotency keys</text>

            <rect x="284" y="70" width="88" height="52" rx="2" class="arch-node" />
            <text x="328" y="92" text-anchor="middle" class="arch-label">API + Tenant</text>
            <text x="328" y="106" text-anchor="middle" class="arch-sub">resolver</text>

            <rect x="416" y="24" width="94" height="42" rx="2" class="arch-node-accent" />
            <text x="463" y="41" text-anchor="middle" class="arch-label">schema: branch_a</text>
            <text x="463" y="55" text-anchor="middle" class="arch-sub">isolated</text>

            <rect x="416" y="80" width="94" height="42" rx="2" class="arch-node-accent" />
            <text x="463" y="97" text-anchor="middle" class="arch-label">schema: branch_b</text>
            <text x="463" y="111" text-anchor="middle" class="arch-sub">isolated</text>

            <rect x="416" y="136" width="94" height="42" rx="2" class="arch-node-accent" />
            <text x="463" y="153" text-anchor="middle" class="arch-label">schema: branch_c</text>
            <text x="463" y="167" text-anchor="middle" class="arch-sub">isolated</text>

            <line x1="104" y1="96" x2="146" y2="96" class="arch-edge-accent" marker-end={`url(#arrow-a-${variant})`} />
            <text x="125" y="88" text-anchor="middle" class="arch-edge-label">batch</text>
            <line x1="238" y1="96" x2="280" y2="96" class="arch-edge" marker-end={`url(#arrow-${variant})`} />
            <path d="M 372 90 Q 396 90 396 52 L 412 45" class="arch-edge-accent" fill="none" marker-end={`url(#arrow-a-${variant})`} />
            <line x1="372" y1="96" x2="412" y2="101" class="arch-edge-accent" marker-end={`url(#arrow-a-${variant})`} />
            <path d="M 372 102 Q 396 102 396 150 L 412 157" class="arch-edge-accent" fill="none" marker-end={`url(#arrow-a-${variant})`} />

            <line x1="57" y1="70" x2="57" y2="44" class="arch-edge arch-edge-dashed" />
            <text x="57" y="36" text-anchor="middle" class="arch-sub">network may drop</text>
          </>
        )
      }

      {
        variant === 'clinical' && (
          <>
            <rect x="10" y="74" width="86" height="48" rx="2" class="arch-node" />
            <text x="53" y="94" text-anchor="middle" class="arch-label">Staff Client</text>
            <text x="53" y="108" text-anchor="middle" class="arch-sub">JWT bearer</text>

            <rect x="138" y="74" width="92" height="48" rx="2" class="arch-node-accent" />
            <text x="184" y="94" text-anchor="middle" class="arch-label">RBAC Gate</text>
            <text x="184" y="108" text-anchor="middle" class="arch-sub">role → scope</text>

            <rect x="272" y="74" width="88" height="48" rx="2" class="arch-node" />
            <text x="316" y="94" text-anchor="middle" class="arch-label">Express API</text>
            <text x="316" y="108" text-anchor="middle" class="arch-sub">strict CORS</text>

            <rect x="402" y="30" width="108" height="46" rx="2" class="arch-node" />
            <text x="456" y="49" text-anchor="middle" class="arch-label">Patient Records</text>
            <text x="456" y="63" text-anchor="middle" class="arch-sub">composite indexes</text>

            <rect x="402" y="120" width="108" height="46" rx="2" class="arch-node-accent" />
            <text x="456" y="139" text-anchor="middle" class="arch-label">Audit Log</text>
            <text x="456" y="153" text-anchor="middle" class="arch-sub">append-only</text>

            <line x1="96" y1="98" x2="134" y2="98" class="arch-edge" marker-end={`url(#arrow-${variant})`} />
            <line x1="230" y1="98" x2="268" y2="98" class="arch-edge-accent" marker-end={`url(#arrow-a-${variant})`} />
            <text x="249" y="90" text-anchor="middle" class="arch-edge-label">scoped</text>
            <path d="M 360 92 Q 384 92 384 56 L 398 53" class="arch-edge" fill="none" marker-end={`url(#arrow-${variant})`} />
            <path d="M 360 106 Q 384 106 384 140 L 398 143" class="arch-edge-accent" fill="none" marker-end={`url(#arrow-a-${variant})`} />
            <text x="184" y="140" text-anchor="middle" class="arch-sub">deny by default</text>
          </>
        )
      }

      {
        variant === 'ticketing' && (
          <>
            <rect x="10" y="34" width="86" height="44" rx="2" class="arch-node" />
            <text x="53" y="52" text-anchor="middle" class="arch-label">Gate A</text>
            <text x="53" y="66" text-anchor="middle" class="arch-sub">QR scan</text>

            <rect x="10" y="120" width="86" height="44" rx="2" class="arch-node" />
            <text x="53" y="138" text-anchor="middle" class="arch-label">Gate B</text>
            <text x="53" y="152" text-anchor="middle" class="arch-sub">QR scan</text>

            <rect x="146" y="76" width="96" height="48" rx="2" class="arch-node" />
            <text x="194" y="96" text-anchor="middle" class="arch-label">Next.js Edge</text>
            <text x="194" y="110" text-anchor="middle" class="arch-sub">static + revalidate</text>

            <rect x="286" y="76" width="100" height="48" rx="2" class="arch-node-accent" />
            <text x="336" y="96" text-anchor="middle" class="arch-label">Redeem TX</text>
            <text x="336" y="110" text-anchor="middle" class="arch-sub">SELECT … FOR UPDATE</text>

            <rect x="424" y="76" width="86" height="48" rx="2" class="arch-node" />
            <text x="467" y="96" text-anchor="middle" class="arch-label">Ticket Row</text>
            <text x="467" y="110" text-anchor="middle" class="arch-sub">issued → used</text>

            <path d="M 96 56 Q 122 56 122 92 L 142 96" class="arch-edge" fill="none" marker-end={`url(#arrow-${variant})`} />
            <path d="M 96 142 Q 122 142 122 108 L 142 104" class="arch-edge" fill="none" marker-end={`url(#arrow-${variant})`} />
            <line x1="242" y1="100" x2="282" y2="100" class="arch-edge" marker-end={`url(#arrow-${variant})`} />
            <line x1="386" y1="100" x2="420" y2="100" class="arch-edge-accent" marker-end={`url(#arrow-a-${variant})`} />
            <text x="336" y="146" text-anchor="middle" class="arch-sub">one admission wins</text>
            <text x="336" y="160" text-anchor="middle" class="arch-sub">the second is rejected</text>
          </>
        )
      }

      {
        variant === 'marketplace' && (
          <>
            <rect x="10" y="76" width="84" height="48" rx="2" class="arch-node" />
            <text x="52" y="96" text-anchor="middle" class="arch-label">Shopper</text>
            <text x="52" y="110" text-anchor="middle" class="arch-sub">mobile web</text>

            <rect x="134" y="76" width="90" height="48" rx="2" class="arch-node" />
            <text x="179" y="96" text-anchor="middle" class="arch-label">Catalogue API</text>
            <text x="179" y="110" text-anchor="middle" class="arch-sub">indexed search</text>

            <rect x="266" y="20" width="88" height="44" rx="2" class="arch-node-accent" />
            <text x="310" y="38" text-anchor="middle" class="arch-label">Redis</text>
            <text x="310" y="52" text-anchor="middle" class="arch-sub">hot catalogue</text>

            <rect x="266" y="132" width="88" height="44" rx="2" class="arch-node" />
            <text x="310" y="150" text-anchor="middle" class="arch-label">PostgreSQL</text>
            <text x="310" y="164" text-anchor="middle" class="arch-sub">source of truth</text>

            <rect x="390" y="76" width="120" height="48" rx="2" class="arch-node-accent" />
            <text x="450" y="96" text-anchor="middle" class="arch-label">Media Worker</text>
            <text x="450" y="110" text-anchor="middle" class="arch-sub">re-encodes to WebP</text>

            <line x1="94" y1="100" x2="130" y2="100" class="arch-edge" marker-end={`url(#arrow-${variant})`} />
            <path d="M 224 92 Q 246 92 246 44 L 262 42" class="arch-edge-accent" fill="none" marker-end={`url(#arrow-a-${variant})`} />
            <text x="250" y="80" class="arch-edge-label">hit</text>
            <path d="M 224 108 Q 246 108 246 152 L 262 154" class="arch-edge arch-edge-dashed" fill="none" marker-end={`url(#arrow-${variant})`} />
            <text x="240" y="126" class="arch-edge-label">miss</text>
            <line x1="354" y1="150" x2="438" y2="128" class="arch-edge arch-edge-dashed" marker-end={`url(#arrow-${variant})`} />
            <text x="396" y="152" text-anchor="middle" class="arch-edge-label">async job</text>
          </>
        )
      }
    </svg>
  </div>

  <figcaption class="arch-caption">
    <strong>How it works:</strong>
    {captions[variant]}
  </figcaption>
</figure>
