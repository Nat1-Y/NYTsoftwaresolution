---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

/*
 * The nav points at sections of the home page. On the home page those are
 * in-page anchors; anywhere else they must lead back to it, or every link on
 * an inner page goes nowhere.
 */
const isHome = Astro.url.pathname === '/';
const to = (hash: string) => (isHome ? hash : `/${hash}`);
---

<header class="main-header">
  <div class="header-container">
    <a
      href={isHome ? '#top' : '/'}
      class="logo"
      aria-label={isHome ? 'NYT Software Solutions — back to top' : 'NYT Software Solutions — home'}
    >
      <Logo size={24} />
      <span class="logo-text" aria-hidden="true">
        <span class="logo-text-main">NYT Software</span>
        <span class="logo-text-sub">Solutions</span>
      </span>
    </a>

    <nav class="nav-menu" aria-label="Primary">
      {nav.map((item) => <a href={to(item.href)} class="nav-link">{item.label}</a>)}
    </nav>

    <div class="header-actions">
      {
        /* The command palette lives on the home page only. */
        isHome && (
          <button
            type="button"
            class="cmdk-trigger"
            data-cmdk-open
            aria-label="Search the site (Control K)"
          >
            <Icon name="search" size={18} />
            <span class="cmdk-trigger-text">Search</span>
            <kbd class="cmdk-hint">Ctrl K</kbd>
          </button>
        )
      }

      <a href={to('#contact')} class="btn btn-primary header-cta">Let's Build</a>

      <button
        class="mobile-nav-toggle"
        id="mobile-nav-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!--
  The phone menu: a full-screen sheet. Each destination carries an icon, a
  one-line hint and its section number, so a first-time visitor can tell what
  is behind a link before tapping it. The primary action sits at the bottom,
  where a thumb already is.
-->
<div class="mobile-nav-menu" id="mobile-nav-menu" inert>
  <div class="mobile-nav-scroll">
    <nav aria-label="Mobile">
      <p class="mobile-nav-kicker" aria-hidden="true">Explore</p>
      <ul class="mobile-nav-list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={to(item.href)} class="mobile-nav-link">
                <span class="mnl-icon" aria-hidden="true"><Icon name={item.icon} size={20} /></span>
                <span class="mnl-text">
                  <span class="mnl-label">{item.label}</span>
                  <span class="mnl-hint">{item.hint}</span>
                </span>
                <span class="mnl-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mobile-nav-kicker" aria-hidden="true">More</p>
      <ul class="mobile-nav-more">
        <li><a href="/products/cafe-manager/" class="mobile-nav-link mnl-chip">Cafe Manager</a></li>
        <li><a href="/working-with-us/" class="mobile-nav-link mnl-chip">Working With Us</a></li>
        <li><a href={to('#faq')} class="mobile-nav-link mnl-chip">FAQ</a></li>
      </ul>

      <div class="mobile-nav-foot">
        <a href={to('#contact')} class="btn btn-primary mobile-cta mobile-nav-link">
          <span>Let's Build</span>
          <Icon name="arrow" size={18} class="arrow-icon" />
        </a>
        <a href={`mailto:${site.email}`} class="mobile-nav-mail">
          <Icon name="mail" size={16} />
          <span>{site.email}</span>
        </a>
      </div>
    </nav>
  </div>
</div>
