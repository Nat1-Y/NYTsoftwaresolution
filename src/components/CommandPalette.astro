---
import Icon from './Icon.astro';
---

<!--
  Command palette. Progressive enhancement: the markup is inert until the
  island hydrates, and every action inside it is reachable another way.
-->
<div
  class="command-palette"
  id="command-palette"
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
>
  <div class="cmdk-panel" role="document">
    <div class="cmdk-search">
      <Icon name="search" size={18} />
      <label class="sr-only" for="cmdk-input">Search the site</label>
      <input
        type="text"
        id="cmdk-input"
        class="cmdk-input"
        placeholder="Jump to a section, project, or action…"
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-results"
        aria-autocomplete="list"
      />
      <kbd class="cmdk-hint">Esc</kbd>
    </div>

    <div class="cmdk-results" id="cmdk-results" role="listbox" aria-label="Results"></div>

    <div class="cmdk-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> select</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>
