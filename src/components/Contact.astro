---
import { site, formConfig, formOptions } from '../data/site';
import Icon from './Icon.astro';
import ContactPlate from './visuals/ContactPlate.astro';

---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" id="contact-title">Let's Build Something</h2>
      <p class="section-subtitle">
        A project in mind, a custom ERP to scope, or a remote engineering
        partnership to discuss? The first consultation is free.
        <a href="/working-with-us/">What to include in your message</a>.
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-details glass">
        <h3>{site.name}</h3>
        <p class="location-details">
          Based in {site.locality}, {site.country} · {site.timezone} · Available
          for global remote contracts
        </p>

        <div class="contact-item">
          <Icon name="mail" size={20} class="contact-icon" />
          <div>
            <span class="detail-label">Direct contact email</span>
            <a href={`mailto:${site.email}`} class="detail-val">{site.email}</a>
          </div>
        </div>

        {
          /* Profiles appear only once they exist and are verified — see
             `linkedin` and `phone` in src/data/site.ts. A placeholder row
             reading "awaiting link" told visitors the company was unfinished. */
          site.phone && (
            <div class="contact-item">
              <Icon name="chat" size={20} class="contact-icon" />
              <div>
                <span class="detail-label">Phone</span>
                <a href={`tel:${site.phone.replace(/\s+/g, '')}`} class="detail-val">{site.phone}</a>
              </div>
            </div>
          )
        }

        {
          site.linkedin && (
            <div class="contact-item">
              <Icon name="linkedin" size={20} class="contact-icon" />
              <div>
                <span class="detail-label">LinkedIn</span>
                <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="detail-val">
                  {site.name}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </div>
            </div>
          )
        }

        <div class="contact-item">
          <Icon name="globe" size={20} class="contact-icon" />
          <div>
            <span class="detail-label">Website</span>
            <a href={site.url} class="detail-val">{new URL(site.url).host}</a>
          </div>
        </div>

        <div class="contact-item">
          <Icon name="github" size={20} class="contact-icon" />
          <div>
            <span class="detail-label">Developer GitHub</span>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="detail-val">
              github.com/Nat1-Y
            </a>
          </div>
        </div>

        <ContactPlate />
      </div>

      <form
        class="contact-form glass"
        id="contact-form"
        novalidate
        data-endpoint={formConfig.endpoint}
        data-mailto={site.email}
      >
        <p class="form-intro">
          Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span>
          are required. Budget and timeline are optional, but they help us
          reply with something useful.
        </p>

        <div class="form-group">
          <label for="form-name">
            Full name / organisation<span class="required-mark" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="form-name"
            name="name"
            autocomplete="organization"
            placeholder="e.g. Spagna Restaurant, or Jane Doe"
            maxlength="120"
            required
            aria-describedby="err-name"
          />
          <span class="field-error" id="err-name" role="alert"></span>
        </div>

        <div class="form-group">
          <label for="form-email">
            Contact email<span class="required-mark" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="form-email"
            name="email"
            autocomplete="email"
            inputmode="email"
            placeholder="email@example.com"
            maxlength="254"
            required
            aria-describedby="err-email"
          />
          <span class="field-error" id="err-email" role="alert"></span>
        </div>

        <div class="form-group">
          <label for="form-subject">Interest area</label>
          <select id="form-subject" name="subject">
            {formOptions.subject.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="form-budget">Budget range <span class="optional-mark">optional</span></label>
            <select id="form-budget" name="budget">
              <option value="">Prefer not to say</option>
              {formOptions.budget.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="form-timeline">Timeline <span class="optional-mark">optional</span></label>
            <select id="form-timeline" name="timeline">
              <option value="">Not decided</option>
              {formOptions.timeline.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="form-message">
            Project description<span class="required-mark" aria-hidden="true">*</span>
          </label>
          <textarea
            id="form-message"
            name="message"
            rows="5"
            maxlength="5000"
            placeholder="What should the system do, who will use it, and what do you use today? Mention your timezone if you are outside Ethiopia."
            required
            aria-describedby="err-message"></textarea>
          <span class="field-error" id="err-message" role="alert"></span>
        </div>

        <!-- Bot trap: hidden from people, irresistible to spam scripts. -->
        <div class="hp-field" aria-hidden="true">
          <label for="form-company-url">Do not fill this in</label>
          <input type="text" id="form-company-url" name="company_url" tabindex="-1" autocomplete="off" />
        </div>

        <label class="form-consent" for="form-consent">
          <input type="checkbox" id="form-consent" name="consent" required aria-describedby="err-consent" />
          <span>
            I'm happy for NYT Software Solutions to contact me about this
            enquiry. How we handle what you send is set out in our
            <a href="/privacy/">privacy notice</a>.
          </span>
        </label>
        <span class="field-error" id="err-consent" role="alert"></span>

        <button type="submit" class="btn btn-primary form-submit">
          <span class="submit-label">Send message</span>
          <Icon name="send" size={18} class="send-icon" />
        </button>

        <!--
          Status is polite-live so the outcome is announced, and it only ever
          reports what actually happened.
        -->
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

        <!--
          Shown when the website cannot deliver the message itself — the
          function is not configured, or is unreachable. The visitor's details
          are handed over as an email draft instead of being dropped.
        -->
        <div class="form-fallback" id="form-fallback" hidden>
          <strong>One more step.</strong> We couldn't deliver this through the
          website just now, and we won't pretend otherwise. Your details are
          ready to send by email:
          <div class="form-fallback-actions">
            <a class="btn btn-primary" id="fallback-mail" href={`mailto:${site.email}`}>
              Open in email app
            </a>
            <button type="button" class="btn btn-secondary" id="fallback-copy">
              Copy message
            </button>
          </div>
        </div>
      </form>    </div>
  </div>
</section>
