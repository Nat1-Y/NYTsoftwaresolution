---
/**
 * The straightforward content sections. Keeping them together avoids a dozen
 * near-identical single-use component files; anything with behaviour or its
 * own data shape lives in its own file instead.
 */
import { services, benefits } from '../data/services';
import { techFilters, techStack } from '../data/tech';
import { process, remoteServices, remoteReasons } from '../data/process';
import { personaCopy, trustSignals, site, team } from '../data/site';
import Icon from './Icon.astro';
import ProductTour from './visuals/ProductTour.astro';
import ServiceVignette from './visuals/ServiceVignette.astro';
import Glyph from './visuals/Glyph.astro';
import RemoteVisuals from './visuals/RemoteVisuals.astro';
import StackPlate from './visuals/StackPlate.astro';
import TechMark from './visuals/TechMark.astro';

const techGroups = techFilters
  .filter((f) => f.id !== 'all')
  .map((f) => ({
    id: f.id,
    label: f.label,
    items: techStack.filter((t) => t.categories[0] === f.id),
  }));
---

<!-- ================= Who We Are ================= -->
<section id="about" class="about-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Who We Are</h2>
      <p class="section-subtitle">
        We design and build custom business software — point of sale, clinic
        and hospital systems, marketplaces, ERPs and mobile apps — for
        organisations in Ethiopia and abroad.
      </p>
    </div>

    <div class="about-grid">
      <div class="about-info-card glass">
        <h3>Enterprise Focus</h3>
        <p>
          We partner with retail networks, healthcare providers, hospitality
          enterprises and global technology teams — designing systems that
          eliminate operational leakage, automate workflow and hold up under
          real security review.
        </p>
      </div>
      <div class="about-info-card glass">
        <h3>Engineering DNA</h3>
        <p>
          Clean schema separation, offline-first client replication, optimised
          database indexing and automated deployment pipelines. International
          enterprise-grade quality at competitive local rates.
        </p>
      </div>
    </div>

    <dl class="company-facts" aria-label="Company facts">
      <div><dt>Company</dt><dd>{site.legalName}</dd></div>
      <div><dt>Founded</dt><dd>{site.founded}</dd></div>
      <div><dt>Based in</dt><dd>{site.locality}, {site.country} · {site.timezone}</dd></div>
      <div><dt>Works with</dt><dd>Clients in Ethiopia and remotely worldwide</dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      <div><dt>Code</dt><dd><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
    </dl>

    {
      team.length > 0 && (
        <div class="team">
          <h3 class="team-title">The team</h3>
          <ul class="team-list">
            {team.map((m) => (
              <li class="team-member">
                <p class="team-name">{m.name}</p>
                <p class="team-role">
                  {m.role}
                  {m.type !== 'employee' && <span class="team-type"> · {m.type}</span>}
                </p>
                {m.summary && <p class="team-summary">{m.summary}</p>}
                {m.linkedin && (
                  <a href={m.linkedin} target="_blank" rel="noopener noreferrer" class="team-link">
                    LinkedIn<span class="sr-only"> profile of {m.name} (opens in a new tab)</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul class="trust-bar">
      {
        trustSignals.map((t) => (
          <li class="trust-item">
            <Icon name={t.icon} size={16} />
            <span>{t.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ================= What We Do ================= -->
<section id="services" class="services-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">What We Do</h2>
      <p class="section-subtitle" id="services-subtitle">
        {personaCopy.business.servicesSubtitle}
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="service-card glass">
            <div class="service-art">
              <ServiceVignette name={service.icon} label={service.art} />
            </div>
            <h3>{service.title}</h3>
            <ul class="service-list">
              {service.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="benefits-container">
      <h3 class="benefits-title">Why Business Partners Trust NYT</h3>
      <div class="benefits-grid">
        {
          benefits.map((b) => (
            <div class="benefit-tag">
              <span aria-hidden="true">✓</span> {b}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<slot name="case-studies" />

<!-- ================= Flagship ================= -->
<section id="flagship" class="flagship-section">
  <div class="container">
    <div class="flagship-card glass">
      <p class="flagship-badge">FLAGSHIP PLATFORM</p>
      <div class="flagship-grid">
        <div class="flagship-content">
          <h2>NYT Cafe Manager</h2>
          <p class="flagship-tagline">
            The enterprise SaaS built for modern hospitality businesses.
          </p>
          <p class="flagship-desc">
            A cloud-native, multi-tenant platform for running restaurant
            branches: real-time kitchen tracking, offline-capable POS, dynamic
            recipe costing and background updates that ship without downtime.
          </p>

          <div class="flagship-features-grid">
            {
              [
                'Multi-tenant schema',
                'Kitchen display (KDS)',
                'Offline POS resiliency',
                'OTA software delivery',
                'COGS & profit reports',
                'Multi-branch sync',
              ].map((f) => (
                <div class="f-item">
                  <span aria-hidden="true">✓</span> {f}
                </div>
              ))
            }
          </div>

          <div class="flagship-actions">
            <a href="#contact" class="btn btn-primary" data-subject="NYT Cafe Manager demo">Request Demo Access</a>
            <a href="/products/cafe-manager/" class="btn btn-secondary">Explore the product</a>
          </div>
        </div>

        <div class="flagship-visual">
          <ProductTour />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= Tech Ecosystem ================= -->
<section id="ecosystem" class="ecosystem-section" data-filter="all">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">The NYT Technical Ecosystem</h2>
      <p class="section-subtitle">
        Our vetted development stack — chosen for speed, scale and long-term
        maintainability.
      </p>
    </div>

    <div class="eco-layout">
      <div class="eco-art">
        <StackPlate />
      </div>

      <div class="eco-main">
        <div class="tech-filters" role="group" aria-label="Filter technologies by category">
          {
            techFilters.map((f, i) => (
              <button
                class:list={['filter-btn', i === 0 && 'active']}
                data-filter={f.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {f.label}
              </button>
            ))
          }
        </div>

        <!--
          Grouped by each technology's first category, under a heading per
          layer. A card keeps every category in data-category, so the filters
          still find TypeScript under Backend as well as Frontend.
        -->
        <div class="tech-grid" id="tech-grid">
          {
            techGroups.map((g) => (
              <>
                <h3 class="tech-group-label" data-group={g.id}>
                  {g.label}
                  <span class="tech-group-count">{g.items.length}</span>
                </h3>
                {g.items.map((t) => (
                  <div class="tech-card glass" data-category={t.categories.join(' ')}>
                    <TechMark name={t.name} />
                    <span class="tech-card-text">
                      <span class="tech-badge">{t.name}</span>
                      <p>{t.note}</p>
                    </span>
                  </div>
                ))}
              </>
            ))
          }
        </div>

        <p class="sr-only" role="status" id="tech-filter-status"></p>
      </div>
    </div>
  </div>
</section>

<!-- ================= Process ================= -->
<section class="process-section" aria-labelledby="process-title">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" id="process-title">Our Development Process</h2>
      <p class="section-subtitle">
        How we turn an idea into stable production software.
      </p>
    </div>

    <ol class="process-timeline">
      {
        process.map((p) => (
          <li class="timeline-step" data-step={p.step}>
            <span class="step-art"><Glyph name={p.glyph} size={44} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ================= Remote partnership ================= -->
<section class="remote-services-section" aria-labelledby="remote-title">
  <div class="container">
    <div class="remote-box glass">
      <div class="remote-header">
        <h2 class="section-title" id="remote-title">
          Remote Development Partner Services
        </h2>
        <p class="lead-text">
          Need to scale your technical capacity? We act as a dedicated remote
          engineering team for international businesses.
        </p>
      </div>

      <RemoteVisuals />

      <div class="remote-grid">
        <div class="remote-column">
          <h3>Our Remote Services</h3>
          <ul class="remote-list">
            {
              remoteServices.map((s) => (
                <li>
                  <span aria-hidden="true">➔</span> {s}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="remote-column">
          <h3>Why International Clients Choose NYT</h3>
          <ul class="remote-list">
            {
              remoteReasons.map((r) => (
                <li>
                  <span aria-hidden="true">➔</span> {r}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
