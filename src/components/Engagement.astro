---
import { engagements } from '../data/engagement';
import EngagementDiagram from './visuals/EngagementDiagram.astro';
import Icon from './Icon.astro';

// Every model carries the same meta rows, in the same order.
const metaLabels = engagements[0]?.meta.map((m) => m.label) ?? [];
---

<section id="engagement" class="engagement-section" aria-labelledby="engagement-title">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" id="engagement-title">How We Work Together</h2>
      <p class="section-subtitle">
        Three ways to engage us. Pick the one that matches where your project
        is today — we will tell you honestly if a different one fits better.
      </p>
    </div>

    <!--
      On a phone the three cards stack, so the differences between them would
      be three screens apart. This table puts them side by side first; the
      cards below then carry the detail. On wider screens the cards sit side by
      side themselves, so the table steps aside and the cards show their own
      rows — the facts are never announced twice.
    -->
    <div class="engagement-compare">
      <table>
        <caption class="sr-only">The three engagement models compared</caption>
        <thead>
          <tr>
            <td></td>
            {
              engagements.map((e) => (
                <th scope="col" class:list={[e.featured && 'is-featured']}>
                  {e.short}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            metaLabels.map((label) => (
              <tr>
                <th scope="row">{label}</th>
                {engagements.map((e) => (
                  <td class:list={[e.featured && 'is-featured']}>
                    {e.meta.find((m) => m.label === label)?.value}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="engagement-grid">
      {
        engagements.map((e) => (
          <div class:list={['engagement-card', 'glass', e.featured && 'featured']}>
            {e.featured && <span class="engagement-flag">Most requested</span>}

            <h3>{e.title}</h3>
            <p class="engagement-for">{e.audience}</p>
            <div class="engagement-art">
              <EngagementDiagram kind={e.art} />
            </div>
            <p class="engagement-desc">{e.description}</p>

            <dl class="engagement-meta">
              {e.meta.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>

            <ul class="engagement-includes">
              {e.includes.map((i) => (
                <li>
                  <Icon name="check" size={15} class="engagement-tick" />
                  <span>{i}</span>
                </li>
              ))}
            </ul>

            <a
              href="#contact"
              class:list={['btn', e.featured ? 'btn-primary' : 'btn-secondary']}
            >
              {e.cta}
            </a>
          </div>
        ))
      }
    </div>

    <p class="engagement-note">
      We do not publish fixed price lists, because a number without a scope
      behind it is guesswork. Tell us what you need and you will get a written
      estimate — the consultation that produces it is free.
      <a href="/working-with-us/">How an engagement runs, step by step</a>.
    </p>
  </div>
</section>
