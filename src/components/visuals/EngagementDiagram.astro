---
/**
 * The shape of each engagement model, drawn: a fixed scope is a line with
 * milestones and an end; a dedicated team is two groups working one board;
 * a retainer is a heartbeat with a monthly allowance under it. Each depicts
 * only what the model's own description promises.
 */
interface Props {
  kind: 'fixed' | 'team' | 'retainer';
}

const { kind } = Astro.props;

const labels = {
  fixed: 'Illustration: a written scope, three signed-off milestones along a line, and a handover flag at the end.',
  team: 'Illustration: your engineers and ours, joined onto one shared board.',
  retainer: 'Illustration: a monitoring heartbeat running across the months, with a pool of feature hours in each month.',
} as const;
---

<svg class="ill engage-ill" viewBox="0 0 240 84" role="img" aria-label={labels[kind]}>
  {kind === 'fixed' && (
    <>
      <rect x="6" y="16" width="26" height="34" class="f0 k" />
      {[23, 29, 35, 41].map((y, i) => <rect x="11" y={y} width={[16, 12, 14, 10][i]} height="2.5" class="fg" />)}
      <path d="M36 33 H208" class="k" />
      {[82, 124, 166].map((x, i) => (
        <g>
          <path d={`M${x} 26 l7 7 l-7 7 l-7 -7 z`} class={i < 2 ? 'fm' : 'f0 sm'} />
          <text x={x} y="56" text-anchor="middle" class="ill-small">M{i + 1}</text>
        </g>
      ))}
      <path d="M216 50 V14 l16 6 l-16 6" class="k" />
      <path d="M216 14 l16 6 l-16 6 z" class="fm" />
      <text x="19" y="68" text-anchor="middle" class="ill-small">SCOPE</text>
      <text x="124" y="72" text-anchor="middle" class="ill-small">SIGNED-OFF MILESTONES</text>
      <text x="222" y="68" text-anchor="middle" class="ill-small">HANDOVER</text>
    </>
  )}

  {kind === 'team' && (
    <>
      {[0, 1, 2].map((i) => <rect x="8" y={10 + i * 20} width="14" height="14" class="f1 k" />)}
      {[0, 1].map((i) => <rect x="218" y={20 + i * 20} width="14" height="14" class="fm" />)}
      {[0, 1, 2].map((i) => <path d={`M22 ${17 + i * 20} C 44 ${17 + i * 20} 44 38 70 38`} class="l" />)}
      {[0, 1].map((i) => <path d={`M218 ${27 + i * 20} C 196 ${27 + i * 20} 196 38 170 38`} class="l" />)}
      <rect x="70" y="8" width="100" height="60" class="f0 k" />
      {[0, 1, 2].map((c) => (
        <g>
          <line x1={70 + c * 33.3} y1="8" x2={70 + c * 33.3} y2="68" class="l" />
          {[0, 1, 2].slice(0, [3, 2, 1][c]).map((r) => (
            <rect x={75 + c * 33.3} y={16 + r * 16} width="23" height="11" class={c === 1 && r === 0 ? 'f1 sm' : 'f1 l'} />
          ))}
        </g>
      ))}
      <text x="15" y="80" text-anchor="middle" class="ill-small">YOURS</text>
      <text x="120" y="80" text-anchor="middle" class="ill-small">ONE BOARD</text>
      <text x="225" y="80" text-anchor="middle" class="ill-small">NYT</text>
    </>
  )}

  {kind === 'retainer' && (
    <>
      <path d="M4 26 H30 L35 14 L41 38 L46 26 H88 L93 14 L99 38 L104 26 H146 L151 14 L157 38 L162 26 H204 L209 14 L215 38 L220 26 H236" class="sm" />
      <line x1="4" y1="50" x2="236" y2="50" class="l" />
      {[0, 1, 2, 3].map((m) => (
        <g>
          <line x1={4 + m * 58} y1="46" x2={4 + m * 58} y2="54" class="k" />
          <rect x={14 + m * 58} y={62 - [6, 10, 8, 12][m]} width="10" height={[6, 10, 8, 12][m]} class="fi" />
          <rect x={28 + m * 58} y="56" width="10" height="6" class="f1 l" />
        </g>
      ))}
      <text x="4" y="78" class="ill-small">MONITORING · FEATURE HOURS · BACKUPS</text>
    </>
  )}
</svg>
