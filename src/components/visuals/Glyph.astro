---
/**
 * Pictograms — one line-drawing family for every small picture on the page:
 * the seven process stages and the five Blueprint system types.
 *
 * Drawn on a 48-unit square in the page's own ink: hairline outlines, one
 * tint for surfaces, and the sienna mark on the single element that carries
 * the meaning (the found thing, the failing check, the shipped release).
 * Decorative by default — the label beside each one says what it is.
 */
interface Props {
  /**
   * Process stages: discover, planning, design, development, qa, deployment,
   * support. Blueprint systems: pos, erp, saas, marketplace, mobile — the ids
   * in src/data/blueprint.ts. An unknown name draws an empty square.
   */
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 48, class: className } = Astro.props;
---

<svg class:list={['ill glyph', className]} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false">
  {name === 'discover' && (
    <>
      <rect x="4" y="6" width="26" height="30" class="f1 k" />
      <rect x="9" y="12" width="14" height="2.5" class="fg" />
      <rect x="9" y="18" width="10" height="2.5" class="fg" />
      <rect x="9" y="24" width="12" height="2.5" class="fg" />
      <circle cx="30" cy="28" r="9" class="f0 k" />
      <circle cx="30" cy="28" r="4" class="fm" />
      <path d="M36.5 34.5 L44 42" class="k" />
    </>
  )}
  {name === 'planning' && (
    <>
      <rect x="17" y="4" width="14" height="10" class="f0 k" />
      <rect x="4" y="32" width="14" height="10" class="f1 k" />
      <rect x="30" y="32" width="14" height="10" class="f1 k" />
      <path d="M24 14 V23 H11 V32 M24 23 H37 V32" class="k" />
      <rect x="21" y="20" width="6" height="6" class="fm" />
    </>
  )}
  {name === 'design' && (
    <>
      <rect x="4" y="6" width="40" height="30" class="f0 k" />
      <line x1="4" y1="12" x2="44" y2="12" class="l" />
      <rect x="9" y="17" width="12" height="14" class="f1 l" />
      <rect x="25" y="17" width="14" height="3" class="fg" />
      <rect x="25" y="23" width="10" height="3" class="fg" />
      <path d="M30 26 L30 42 L34 38 L37 44 L39.5 43 L36.5 37 L42 37 Z" class="fm" />
    </>
  )}
  {name === 'development' && (
    <>
      <rect x="4" y="6" width="40" height="32" class="f0 k" />
      <line x1="4" y1="12" x2="44" y2="12" class="l" />
      <path d="M17 18 L11 24 L17 30" class="k" />
      <path d="M31 18 L37 24 L31 30" class="k" />
      <path d="M26.5 16 L21.5 32" class="sm" />
      <rect x="10" y="41" width="28" height="3" class="fg" />
    </>
  )}
  {name === 'qa' && (
    <>
      <rect x="8" y="4" width="32" height="40" class="f0 k" />
      {[12, 21, 30].map((y, i) => (
        <g>
          <rect x="13" y={y} width="6" height="6" class={i === 2 ? 'f0 sm' : 'f1 l'} />
          <path d={i === 2 ? `M14 ${y + 1} l4 4 M18 ${y + 1} l-4 4` : `M14 ${y + 3} l2 2 l3 -4`} class={i === 2 ? 'sm' : 'k'} />
          <rect x="23" y={y + 1.5} width={[12, 10, 13][i]} height="2.5" class="fg" />
        </g>
      ))}
    </>
  )}
  {name === 'deployment' && (
    <>
      <path d="M13 30 a7 7 0 0 1 1 -13.9 a10 10 0 0 1 19.4 2.4 a6 6 0 0 1 1.6 11.5 Z" class="f0 k" />
      <path d="M24 44 V24 M18 30 L24 24 L30 30" class="sm" />
      <rect x="6" y="40" width="10" height="4" class="f1 l" />
      <rect x="32" y="40" width="10" height="4" class="f1 l" />
    </>
  )}
  {name === 'support' && (
    <>
      <rect x="4" y="8" width="40" height="28" class="f0 k" />
      <path d="M8 24 H16 L19 16 L24 32 L28 20 L31 24 H40" class="sm" />
      <path d="M18 42 H30 M24 36 V42" class="k" />
    </>
  )}

  {name === 'pos' && (
    <>
      <rect x="10" y="6" width="28" height="20" class="f0 k" />
      <rect x="14" y="10" width="12" height="2.5" class="fg" />
      <rect x="14" y="15" width="16" height="2.5" class="fg" />
      <rect x="27" y="19" width="7" height="4" class="fm" />
      <path d="M20 26 L18 32 H30 L28 26" class="k" />
      <rect x="6" y="32" width="36" height="10" class="f1 k" />
      <rect x="12" y="36" width="10" height="2.5" class="fg" />
    </>
  )}
  {name === 'erp' && (
    <>
      <rect x="4" y="6" width="40" height="36" class="f0 k" />
      <line x1="4" y1="14" x2="44" y2="14" class="l" />
      <line x1="16" y1="14" x2="16" y2="42" class="l" />
      {[19, 26, 33].map((y, i) => (
        <g>
          <rect x="20" y={y} width={[18, 12, 15][i]} height="3" class="fg" />
          <rect x="8" y={y} width="4" height="3" class={i === 0 ? 'fm' : 'fg'} />
        </g>
      ))}
    </>
  )}
  {name === 'saas' && (
    <>
      <path d="M24 30 L42 21 L24 12 L6 21 Z" class="f2 k" transform="translate(0 10)" />
      <path d="M24 30 L42 21 L24 12 L6 21 Z" class="f1 k" transform="translate(0 3)" />
      <path d="M24 30 L42 21 L24 12 L6 21 Z" class="f0 sm" transform="translate(0 -4)" />
      <circle cx="24" cy="17" r="2" class="fm" />
    </>
  )}
  {name === 'marketplace' && (
    <>
      <path d="M6 18 L10 6 H38 L42 18 Z" class="f1 k" />
      <path d="M6 18 q4.5 5 9 0 q4.5 5 9 0 q4.5 5 9 0 q4.5 5 9 0" class="k" />
      <rect x="8" y="22" width="32" height="20" class="f0 k" />
      <rect x="13" y="28" width="10" height="14" class="f1 l" />
      <rect x="27" y="28" width="9" height="7" class="fm" />
    </>
  )}
  {name === 'mobile' && (
    <>
      <rect x="14" y="3" width="20" height="42" rx="3" class="f0 k" />
      <line x1="14" y1="9" x2="34" y2="9" class="l" />
      <line x1="14" y1="38" x2="34" y2="38" class="l" />
      <rect x="18" y="13" width="12" height="9" class="f1 l" />
      <rect x="18" y="25" width="10" height="2.5" class="fg" />
      <rect x="18" y="30" width="7" height="3" class="fm" />
    </>
  )}
</svg>
