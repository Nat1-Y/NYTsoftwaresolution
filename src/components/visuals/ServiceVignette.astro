---
/**
 * One small drawing per service column, keyed by the service's icon name in
 * src/data/services.ts. Each shows the thing that service actually delivers:
 * tenant schemas behind a ledger, a till feeding a kitchen rail, a schedule
 * behind a guarded record, a catalogue shipping along a route.
 */
import { box, faceTop } from '../../lib/iso';

interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;

// Three stacked tenant slabs for the ERP / SaaS drawing.
const slabs = [0, 18, 36].map((z) => box(0, 0, z, 60, 60, 8));
---

<svg class="ill vignette" viewBox="0 0 240 120" role="img" aria-label={`Illustration: ${label}`}>
  {name === 'layers' && (
    <>
      <g transform="translate(60 44)">
        {slabs.map((s, i) => (
          <g>
            <polygon points={s.left} class="f1 k" />
            <polygon points={s.right} class="f2 k" />
            <polygon points={s.top} class={i === 2 ? 'f0 sm' : 'f0 k'} />
          </g>
        ))}
        <g transform={faceTop(0, 0, 44)}>
          <rect x="10" y="10" width="18" height="18" class="f1 l" />
          <rect x="32" y="10" width="18" height="18" class="f1 l" />
          <rect x="10" y="32" width="40" height="18" class="fm" />
        </g>
      </g>
      <text x="10" y="112" class="ill-micro">TENANT SCHEMAS</text>
      <rect x="138" y="10" width="94" height="96" class="f0 k" />
      <text x="146" y="24" class="ill-micro">LEDGER · COGS</text>
      {[34, 46, 58, 70].map((y, i) => (
        <g>
          <line x1="146" y1={y - 3} x2="224" y2={y - 3} class="l" />
          <rect x="146" y={y} width={[34, 28, 38, 24][i]} height="3" class="fg" />
          <rect x={210 - [10, 16, 6, 12][i]} y={y} width={[14, 20, 10, 16][i]} height="3" class="fi" />
        </g>
      ))}
      {[18, 26, 14, 32, 22].map((h, i) => (
        <rect x={148 + i * 15} y={100 - h} width="9" height={h} class={i === 3 ? 'fm' : 'fg'} />
      ))}
    </>
  )}

  {name === 'pos' && (
    <>
      <rect x="10" y="14" width="80" height="54" class="f0 k" />
      <rect x="16" y="20" width="44" height="42" class="f1 l" />
      {[26, 34, 42, 50].map((y, i) => (
        <rect x="21" y={y} width={[30, 24, 32, 20][i]} height="3" class="fg" />
      ))}
      <rect x="64" y="46" width="20" height="16" class="fa" />
      <path d="M40 68 L36 80 H64 L60 68" class="k" />
      <rect x="20" y="80" width="60" height="16" class="f1 k" />
      <path d="M96 40 C 112 40 112 24 128 24" class="l dash" />
      <text x="232" y="112" text-anchor="end" class="ill-micro">OFFLINE-FIRST TILL → KITCHEN RAIL</text>
      <line x1="126" y1="18" x2="232" y2="18" class="k" />
      {[0, 1, 2].map((i) => (
        <g>
          <rect x={132 + i * 34} y="15" width="6" height="7" class="fi" />
          <path d={`M${128 + i * 34} 22 H${156 + i * 34} V${[78, 64, 88][i]} l-4 -3 l-3 3 l-3 -3 l-3 3 l-3 -3 l-3 3 l-3 -3 l-3 3 Z`} class={i === 0 ? 'f0 sm' : 'f0 k'} />
          <rect x={132 + i * 34} y="30" width="18" height="3" class={i === 0 ? 'fm' : 'fi'} />
          {[38, 45, 52].map((y) => <rect x={132 + i * 34} y={y} width="16" height="2.5" class="fg" />)}
        </g>
      ))}
    </>
  )}

  {name === 'health' && (
    <>
      <rect x="10" y="10" width="120" height="96" class="f0 k" />
      <line x1="10" y1="24" x2="130" y2="24" class="l" />
      <text x="16" y="20" class="ill-micro">APPOINTMENTS</text>
      {[0, 1, 2, 3, 4].map((c) => <line x1={10 + c * 24} y1="24" x2={10 + c * 24} y2="106" class="l" />)}
      {[40, 56, 72, 88].map((y) => <line x1="10" y1={y} x2="130" y2={y} class="l" />)}
      {[[0, 0, 2], [1, 1, 1], [2, 0, 1], [2, 2, 2], [3, 1, 2], [4, 3, 1]].map(([c, r, h], i) => (
        <rect x={12 + c! * 24} y={26 + r! * 16} width="20" height={h! * 16 - 4} class={i === 3 ? 'fm' : 'f2'} />
      ))}
      <rect x="146" y="22" width="84" height="72" class="f1 k" />
      {[36, 46, 56].map((y, i) => (
        <rect x="154" y={y} width={[44, 36, 50][i]} height="3" class="fg" />
      ))}
      <rect x="154" y="70" width="30" height="3" class="fg" />
      <path d="M202 58 h20 v12 q0 12 -10 16 q-10 -4 -10 -16 z" class="f0 sm" />
      <rect x="208" y="68" width="8" height="7" class="fm" />
      <path d="M209 68 v-3 a3 3 0 0 1 6 0 v3" class="sm" />
      <text x="146" y="112" class="ill-micro">ROLE-GATED · AUDITED</text>
    </>
  )}

  {name === 'cart' && (
    <>
      {[0, 1].flatMap((r) =>
        [0, 1].map((c) => (
          <g>
            <rect x={10 + c * 50} y={10 + r * 50} width="44" height="44" class="f0 k" />
            <rect x={15 + c * 50} y={15 + r * 50} width="34" height="20" class={r === 0 && c === 1 ? 'f1 sm' : 'f1 l'} />
            <rect x={15 + c * 50} y={40 + r * 50} width="22" height="3" class="fg" />
            <rect x={15 + c * 50} y={46 + r * 50} width="12" height="3" class="fi" />
          </g>
        ))
      )}
      <path d="M124 40 C 150 40 150 84 178 84 S 214 50 220 30" class="wire" />
      <path d="M124 40 C 150 40 150 84 178 84 S 214 50 220 30" class="flow" />
      <rect x="116" y="32" width="16" height="16" class="f1 k" />
      <path d="M116 32 l8 -7 l8 7" class="k" />
      <path d="M220 30 m-7 0 a7 7 0 1 1 14 0 q0 6 -7 14 q-7 -8 -7 -14 z" class="f0 sm" />
      <circle cx="220" cy="30" r="2.5" class="fm" />
      <text x="232" y="112" text-anchor="end" class="ill-micro">CATALOGUE → ORDER → DELIVERY</text>
    </>
  )}
</svg>
