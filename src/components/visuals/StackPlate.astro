---
/**
 * The stack as an exploded drawing: four layers, infrastructure at the
 * bottom, the interface people touch at the top. It is a key for the index
 * beside it — choosing a filter lifts the matching layer (see the
 * [data-filter] rules in 48-visuals.css) — so it is hidden from assistive
 * tech, which gets the same grouping from the filter buttons and headings.
 */
import { box, faceTop, p } from '../../lib/iso';

const layers = [
  { id: 'infrastructure', label: 'Infrastructure', z: 0 },
  { id: 'databases', label: 'Databases', z: 38 },
  { id: 'backend', label: 'Backend & APIs', z: 76 },
  { id: 'frontend', label: 'Frontend', z: 114 },
].map((l) => ({ ...l, box: box(0, 0, l.z, 84, 84, 8), tip: p(84, 0, l.z + 4) }));
---

<svg class="ill stack-ill" viewBox="-80 -132 282 222" aria-hidden="true" focusable="false">
  {
    layers.map((l) => (
      <g class="stack-layer" data-layer={l.id}>
        <polygon points={l.box.left} class="f1 k" />
        <polygon points={l.box.right} class="f2 k" />
        <polygon points={l.box.top} class="f0 k stack-top" />
        <g transform={faceTop(0, 0, l.z + 8)}>
          {l.id === 'frontend' && (
            <>
              <rect x="16" y="16" width="52" height="40" class="f1 l" />
              <line x1="16" y1="24" x2="68" y2="24" class="l" />
              <rect x="22" y="32" width="18" height="16" class="fm stack-accent" />
            </>
          )}
          {l.id === 'backend' && (
            <>
              <rect x="14" y="30" width="16" height="16" class="f1 l" />
              <rect x="54" y="14" width="16" height="16" class="fm stack-accent" />
              <rect x="54" y="50" width="16" height="16" class="f1 l" />
              <path d="M30 38 H42 V22 H54 M42 38 V58 H54" class="l" />
            </>
          )}
          {l.id === 'databases' && (
            <>
              <circle cx="28" cy="28" r="11" class="f1 l" />
              <circle cx="56" cy="28" r="11" class="fm stack-accent" />
              <circle cx="28" cy="58" r="11" class="f1 l" />
              <circle cx="56" cy="58" r="11" class="f1 l" />
            </>
          )}
          {l.id === 'infrastructure' && (
            <>
              {[0, 1, 2].flatMap((c) =>
                [0, 1].map((r) => (
                  <rect x={14 + c * 20} y={22 + r * 22} width="15" height="15" class={c === 1 && r === 0 ? 'fm stack-accent' : 'f1 l'} />
                ))
              )}
            </>
          )}
        </g>
        <path d={`M${l.tip[0] + 4} ${l.tip[1]} H96`} class="l" />
        <text x="100" y={l.tip[1] + 3.5} class="ill-label stack-label">{l.label}</text>
      </g>
    ))
  }
</svg>
