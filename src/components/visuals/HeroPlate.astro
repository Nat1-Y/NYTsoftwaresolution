---
/**
 * The hero plate: the kinds of system this page is about, drawn as one
 * network on a drafting board.
 *
 * A point of sale, an owner's dashboard, a clinic desk and a ticket gate —
 * one for each case study below — all wired to a single application tier and
 * a row of isolated tenant databases. It is an illustration and says so in
 * its caption; the console beside it carries the real specs.
 *
 * Every shape is projected from 3D coordinates at build time (src/lib/iso.ts),
 * so the drawing stays on one grid and costs no JavaScript. Colours come from
 * the theme tokens: paper and ink in the business view, a blueprint in the
 * engineering one.
 */
import Plate from './Plate.astro';
import { p, box, path, faceY, faceX, faceTop, cylinder } from '../../lib/iso';

/* ---------------------------------------------------------------- board -- */
const W = 320;
const D = 260;
const board = box(0, 0, -10, W, D, 10);
const grid: string[] = [];
for (let x = 20; x < W; x += 20) grid.push(path([[x, 0], [x, D]]));
for (let y = 20; y < D; y += 20) grid.push(path([[0, y], [W, y]]));

/* ------------------------------------------------------------- wiring -- */
// A backbone along y = 100, with one spur per device. Pulses travel along the
// spurs toward the backbone, i.e. from where the work happens to the record.
const backbone = path([[60, 100], [258, 100]]);
const spurs = [
  path([[60, 178], [60, 100]]), // POS
  path([[166, 146], [166, 100]]), // laptop
  path([[258, 122], [258, 100]]), // clinic tablet
  path([[236, 226], [228, 226], [228, 100]]), // phone / gate
];
const toRack = path([[140, 100], [140, 64]]);
const dbBus = path([[170, 40], [272, 40]]);

/* ------------------------------------------------------ application rack -- */
const rackUnits = [0, 44, 88].map((z) => box(110, 20, z, 60, 44, 38));
const rackFace = (z: number) => faceY(110, 64, z + 38);

/* ------------------------------------------------------- tenant schemas -- */
const dbs = [200, 236, 272].map((x) => cylinder(x, 40, 0, 13, 34));
const dbBands = [200, 236, 272].map((x) => cylinder(x, 40, 0, 13, 17));

/* --------------------------------------------------------------- laptop -- */
const lapBase = box(120, 150, 0, 92, 56, 4);
const lapLid = box(120, 146, 4, 92, 4, 60);

/* ------------------------------------------------------------------ POS -- */
const posBody = box(30, 180, 0, 60, 50, 16);
const posScreen = box(36, 186, 16, 48, 4, 46);
const printer = box(94, 200, 0, 20, 26, 20);

/* --------------------------------------------------------- clinic tablet -- */
const stand = box(252, 122, 0, 12, 16, 22);
const tablet = box(264, 100, 22, 4, 60, 62);

/* ---------------------------------------------------------- phone / gate -- */
const phone = box(236, 200, 0, 30, 52, 3);
const gatePostA = box(286, 186, 0, 8, 8, 44);
const gatePostB = box(286, 240, 0, 8, 8, 44);
const gateArm = box(288, 194, 30, 4, 46, 3);

// QR modules: a fixed pattern (not a scannable code — it is a drawing).
const qr = [
  '1110111', '1010100', '1110101', '0001010', '1011111', '0100101', '1101011',
];

/* -------------------------------------------------------------- labels -- */
// The board is a diamond, so its bounding box has four empty corners. The
// callouts live there, which keeps them clear of the objects and inside one
// tight viewBox at every width.
// `to` is where the leader ends; `ty` places the text above (-) or below (+).
const callouts = [
  { at: p(110, 20, 126), to: [-4, -61], ty: 4, anchor: 'end', text: 'Application tier' },
  { at: p(236, 40, 34), to: [170, 30], ty: -7, anchor: 'middle', text: 'Tenant schemas' },
  { at: p(36, 186, 62), to: [-129, 4], ty: -7, anchor: 'middle', text: 'POS · offline-first' },
  { at: p(120, 206, 0), to: [-74, 262], ty: 14, anchor: 'middle', text: "Owner's dashboard" },
  { at: p(268, 130, 60), to: [214, 228], ty: 14, anchor: 'middle', text: 'Clinic desk' },
  { at: p(290, 217, 33), to: [150, 282], ty: 14, anchor: 'middle', text: 'Gate · QR redeem' },
];
---

<Plate kind="illustration" class="hero-plate">
  <svg
    class="ill hero-ill"
    viewBox="-232 -82 518 386"
    role="img"
    aria-label="Illustration: a point of sale, an owner's dashboard, a clinic desk and a QR ticket gate, all connected to one application tier and a row of isolated tenant databases."
  >
    <!-- board -->
    <polygon points={board.left} class="f1 k" />
    <polygon points={board.right} class="f2 k" />
    <polygon points={board.top} class="f0 k" />
    <g class="ill-grid">{grid.map((d) => <path d={d} class="l" />)}</g>

    <!-- wiring, under everything that stands on the board -->
    <path d={backbone} class="wire" />
    <path d={toRack} class="wire" />
    <path d={dbBus} class="wire" />
    {spurs.map((d) => <path d={d} class="wire" />)}
    {spurs.map((d, i) => <path d={d} class="flow" style={`animation-delay:${i * -0.8}s`} />)}
    <path d={toRack} class="flow flow-up" />

    <!-- application rack -->
    {
      rackUnits.map((u, i) => (
        <g>
          <polygon points={u.left} class="f1 k" />
          <polygon points={u.right} class="f2 k" />
          <polygon points={u.top} class="f0 k" />
          <g transform={rackFace([0, 44, 88][i]!)}>
            <rect x="6" y="8" width="30" height="3" class="fg" />
            <rect x="6" y="15" width="30" height="3" class="fg" />
            <rect x="6" y="22" width="30" height="3" class="fg" />
            <circle cx="46" cy="10" r="2" class={i === 1 ? 'fm' : 'fa'} />
            <circle cx="53" cy="10" r="2" class="fg" />
          </g>
        </g>
      ))
    }

    <!-- tenant schemas -->
    {
      dbs.map((c, i) => (
        <g>
          <path d={c.body} class="f1 k" />
          <path
            d={`M${c.top.cx - c.top.rx} ${dbBands[i]!.top.cy} A${c.top.rx} ${c.top.ry} 0 0 0 ${c.top.cx + c.top.rx} ${dbBands[i]!.top.cy}`}
            class="k"
          />
          <ellipse cx={c.top.cx} cy={c.top.cy} rx={c.top.rx} ry={c.top.ry} class="f0 k" />
        </g>
      ))
    }

    <!-- POS terminal + receipt printer -->
    <polygon points={posBody.left} class="f1 k" />
    <polygon points={posBody.right} class="f2 k" />
    <polygon points={posBody.top} class="f0 k" />
    <polygon points={posScreen.left} class="f0 k" />
    <polygon points={posScreen.right} class="f2 k" />
    <polygon points={posScreen.top} class="f1 k" />
    <g transform={faceY(36, 190, 62)}>
      <rect x="3" y="3" width="42" height="40" class="f1" />
      <rect x="6" y="7" width="20" height="2.5" class="fg" />
      <rect x="6" y="13" width="26" height="2" class="fg" />
      <rect x="6" y="18" width="22" height="2" class="fg" />
      <rect x="6" y="23" width="24" height="2" class="fg" />
      <line x1="6" y1="29" x2="42" y2="29" class="l" />
      <rect x="6" y="32" width="14" height="2.5" class="fi" />
      <rect x="28" y="31" width="14" height="8" class="fa" />
    </g>
    <polygon points={printer.left} class="f1 k" />
    <polygon points={printer.right} class="f2 k" />
    <polygon points={printer.top} class="f0 k" />
    <path d={path([[100, 213, 20], [100, 213, 34], [108, 213, 38]])} class="k receipt" />

    <!-- laptop -->
    <polygon points={lapBase.left} class="f1 k" />
    <polygon points={lapBase.right} class="f2 k" />
    <polygon points={lapBase.top} class="f0 k" />
    <g transform={faceTop(120, 150, 4)}>
      {
        [8, 16, 24, 32].map((y) => (
          <rect x="10" y={y} width="72" height="4" class="fg key-row" />
        ))
      }
      <rect x="32" y="42" width="28" height="9" class="f1 k" />
    </g>
    <polygon points={lapLid.right} class="f2 k" />
    <polygon points={lapLid.top} class="f1 k" />
    <polygon points={lapLid.left} class="f0 k" />
    <g transform={faceY(120, 150, 64)}>
      <rect x="4" y="4" width="84" height="52" class="f1" />
      <rect x="4" y="4" width="14" height="52" class="f2" />
      <rect x="7" y="9" width="8" height="2" class="fg" />
      <rect x="7" y="14" width="8" height="2" class="fg" />
      <rect x="7" y="19" width="8" height="2" class="fm" />
      <rect x="22" y="8" width="19" height="10" class="f0 l" />
      <rect x="44" y="8" width="19" height="10" class="f0 l" />
      <rect x="66" y="8" width="19" height="10" class="f0 l" />
      <rect x="25" y="11" width="9" height="2" class="fi" />
      <rect x="47" y="11" width="11" height="2" class="fi" />
      <rect x="69" y="11" width="7" height="2" class="fi" />
      {
        [14, 20, 17, 26, 22, 30, 34].map((h, i) => (
          <rect x={24 + i * 8.6} y={52 - h} width="5" height={h} class={i === 6 ? 'fm' : 'fg'} />
        ))
      }
      <path d="M24 40 L32 37 L41 39 L49 31 L58 33 L67 26 L77 22" class="sa trend" />
    </g>

    <!-- clinic tablet on its stand -->
    <polygon points={stand.left} class="f1 k" />
    <polygon points={stand.right} class="f2 k" />
    <polygon points={tablet.left} class="f1 k" />
    <polygon points={tablet.top} class="f1 k" />
    <polygon points={tablet.right} class="f0 k" />
    <g transform={faceX(268, 160, 84)}>
      <rect x="4" y="4" width="52" height="58" class="f1" />
      <rect x="8" y="8" width="22" height="3" class="fi" />
      <path d="M47 7 h6 v4 q0 4 -3 5 q-3 -1 -3 -5 z" class="f0 sm shield" />
      {
        [18, 28, 38, 48].map((y, i) => (
          <g>
            <rect x="8" y={y} width="10" height="6" class={i === 1 ? 'fm' : 'f2'} />
            <rect x="21" y={y + 1} width={[24, 18, 26, 20][i]} height="2" class="fg" />
            <rect x="21" y={y + 4} width={[14, 12, 16, 10][i]} height="1.5" class="fg" />
          </g>
        ))
      }
    </g>

    <!-- phone lying at the gate -->
    <polygon points={phone.left} class="f1 k" />
    <polygon points={phone.right} class="f2 k" />
    <polygon points={phone.top} class="f0 k" />
    <g transform={faceTop(238, 204, 3)}>
      <rect x="0" y="0" width="26" height="44" class="f1" />
      {
        qr.flatMap((row, r) =>
          [...row].map((c, col) =>
            c === '1' ? <rect x={4 + col * 2.6} y={5 + r * 2.6} width="2.6" height="2.6" class="fi" /> : null
          )
        )
      }
      <line x1="3" y1="27" x2="23" y2="27" class="l dash" />
      <rect x="4" y="31" width="14" height="2" class="fg" />
      <rect x="4" y="36" width="18" height="4" class="fm" />
    </g>

    <!-- turnstile -->
    <polygon points={gatePostA.left} class="f1 k" />
    <polygon points={gatePostA.right} class="f2 k" />
    <polygon points={gatePostA.top} class="f0 k" />
    <polygon points={gateArm.left} class="fm k" />
    <polygon points={gateArm.top} class="fm k" />
    <polygon points={gatePostB.left} class="f1 k" />
    <polygon points={gatePostB.right} class="f2 k" />
    <polygon points={gatePostB.top} class="f0 k" />

    <!-- callouts: hidden on small screens, where the caption carries them -->
    <g class="ill-callouts">
      {
        callouts.map((c) => (
          <g>
            <circle cx={c.at[0]} cy={c.at[1]} r="2" class="fm" />
            <path d={`M${c.at[0]} ${c.at[1]} L${c.to[0]} ${c.to[1]}`} class="l" />
            <text
              x={c.to[0]! + (c.anchor === 'end' ? -5 : c.anchor === 'start' ? 5 : 0)}
              y={c.to[1]! + c.ty}
              text-anchor={c.anchor}
              class="ill-label"
            >
              {c.text}
            </text>
          </g>
        ))
      }
    </g>
  </svg>

  <Fragment slot="caption">
    The four kinds of system on this page — point of sale, owner's dashboard,
    clinic desk, ticket gate — drawn as one network writing to isolated tenant
    databases.
  </Fragment>
</Plate>
