---
import { site } from '../data/site';
import { faqs } from '../data/faq';
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
  /** Emit the FAQPage structured data (index page only). */
  includeFaqSchema?: boolean;
  /** Extra JSON-LD objects for this page (breadcrumbs, a product, an article). */
  schema?: Record<string, unknown>[];
}

const {
  title = `${site.name} | Enterprise Software & Remote Engineering`,
  description = site.description,
  includeFaqSchema = false,
  schema = [],
} = Astro.props;

/*
 * Two families, each with a job:
 *   Archivo        — everything you read. Variable on weight and width: the
 *                    expanded widths set the headlines, normal width the body,
 *                    so one file carries both.
 *   JetBrains Mono — anything that is a measurement: specs, labels, the console.
 *
 * Noto Sans Ethiopic carries the two places the page sets Ge'ez — the section
 * numerals and the footer sign-off — subset to just those glyphs.
 *
 * All are self-hosted (src/styles/fonts.css, generated by scripts/fonts.mjs):
 * no page view touches a third-party server, and each subset is fetched only
 * when a page uses its characters. The face the first screen paints with is
 * preloaded.
 */
const preloadFonts = ['/fonts/archivo-latin-normal-1.woff2'];

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og-image.png', Astro.site ?? site.url).href;

/* ---- Structured data ---------------------------------------------------- */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  description: site.description,
  image: ogImage,
  logo: `${site.url}/favicon.svg`,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressCountry: site.countryCode,
  },
  areaServed: [
    { '@type': 'Country', name: 'Ethiopia' },
    { '@type': 'Place', name: 'Worldwide (remote engagements)' },
  ],
  knowsAbout: [
    'Enterprise Resource Planning',
    'Multi-tenant SaaS architecture',
    'Point of sale systems',
    'Healthcare information systems',
    'E-commerce marketplaces',
    'Offline-first application design',
  ],
  sameAs: [site.github, site.linkedin].filter(Boolean),
  ...(site.phone ? { telephone: site.phone } : {}),
  serviceType: [
    'Custom software development',
    'ERP development',
    'SaaS platform engineering',
    'Mobile application development',
    'Remote engineering partnership',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.name,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const schemas = [
  orgSchema,
  websiteSchema,
  ...(includeFaqSchema ? [faqSchema] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover lets the fixed bars reach the screen edges on
         notched phones; their padding uses env(safe-area-inset-*). -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />

    <!-- Icons & PWA -->
    <!-- Generated by `npm run og`. Browsers that read SVG take the last icon;
         older ones and crawlers use the .ico; Google Search shows the 48px PNG
         beside results (it wants a multiple of 48px).
         The ?v= is deliberate: browsers cache tab icons by URL and ignore a
         normal refresh, so bump it whenever the icon artwork changes. -->
    <link rel="icon" href="/favicon.ico?v=5" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Self-hosted fonts: the two faces the first screen paints with, fetched
      early. Measured with Lighthouse (mobile, three runs each): dropping these
      preloads, or loading the @font-face rules asynchronously, both made first
      paint slower than this arrangement.
    -->
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    {
      schemas.map((s) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(s)}
        />
      ))
    }

    <!--
      Set the persona class before first paint so the accent colour never
      flashes from the default to the visitor's saved preference.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var mode = 'business';
        try {
          if (localStorage.getItem('nyt-persona') === 'tech') mode = 'tech';
        } catch (e) {
          /* private mode — fall back to the default persona */
        }
        root.classList.add('mode-' + mode);
        // Arriving at a #section: lay every section out at its real height
        // before the browser scrolls there (see styles/layout.css).
        if (location.hash.length > 1) root.classList.add('cv-full');
      })();
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
